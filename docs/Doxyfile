# Doxyfile for Special-Relativity-in-Financial-Modeling
# Generate HTML API documentation with: doxygen docs/Doxyfile
# Output will be written to docs/api/

#---------------------------------------------------------------------------
# Project metadata
#---------------------------------------------------------------------------

PROJECT_NAME           = Special-Relativity-in-Financial-Modeling
PROJECT_NUMBER         = 1.0.0
PROJECT_BRIEF          = "C++20 library applying special-relativistic geometry to financial signal processing."

#---------------------------------------------------------------------------
# Input
#---------------------------------------------------------------------------

INPUT                  = src/ include/
RECURSIVE              = YES
FILE_PATTERNS          = *.h *.hpp *.cpp

#---------------------------------------------------------------------------
# Extraction
#---------------------------------------------------------------------------

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES

#---------------------------------------------------------------------------
# Output
#---------------------------------------------------------------------------

OUTPUT_DIRECTORY       = docs/api
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html
HTML_COLORSTYLE        = AUTO_DARK

#---------------------------------------------------------------------------
# Source browsing
#---------------------------------------------------------------------------

SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES

#---------------------------------------------------------------------------
# Preprocessor
#---------------------------------------------------------------------------

ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = NO
PREDEFINED             = SRFM_FUZZ \
                         EIGEN_INITIALIZE_MATRICES_BY_ZERO

#---------------------------------------------------------------------------
# Diagrams (requires Graphviz dot)
#---------------------------------------------------------------------------

HAVE_DOT               = NO
CLASS_DIAGRAMS         = YES
COLLABORATION_GRAPH    = YES
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = YES
CALL_GRAPH             = NO
CALLER_GRAPH           = NO

#---------------------------------------------------------------------------
# Warnings
#---------------------------------------------------------------------------

QUIET                  = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
