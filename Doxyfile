# Doxyfile for Special Relativity in Financial Modeling (SRFM)
# Run: doxygen Doxyfile

PROJECT_NAME           = "Special Relativity in Financial Modeling"
PROJECT_NUMBER         = 1.0.0
PROJECT_BRIEF          = "Lorentz transforms, spacetime classification, and geodesic price paths for quantitative finance"

OUTPUT_DIRECTORY       = docs/api

INPUT                  = src include README.md
FILE_PATTERNS          = *.cpp *.hpp *.h *.md
RECURSIVE              = YES

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES

USE_MDFILE_AS_MAINPAGE = README.md

GENERATE_HTML          = YES
GENERATE_LATEX         = NO

HTML_OUTPUT            = html
HTML_TIMESTAMP         = YES

QUIET                  = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES

HAVE_DOT               = NO
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO

MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES

ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = NO

TYPEDEF_HIDES_STRUCT   = NO
STRIP_CODE_COMMENTS    = NO
